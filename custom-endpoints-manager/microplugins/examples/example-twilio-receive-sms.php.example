<?php
/**
 * DEMO MICROPLUGIN: Twilio Inbound SMS Receiver
 *
 * Endpoint setup:
 *   Slug:        webhook/twilio
 *   Methods:     POST
 *   Capability:  read           (Twilio sends unauthenticated — validate via signature)
 *   Async:       No             (must respond with TwiML immediately)
 *
 * Set this endpoint URL in your Twilio phone number's "A MESSAGE COMES IN" webhook.
 *
 * WP options used:
 *   cem_twilio_auth_token — Twilio Auth Token (for signature validation)
 *
 * Twilio POST params: AccountSid, MessageSid, From, To, Body, NumMedia, etc.
 *
 * What this does:
 *  1. Validates Twilio request signature
 *  2. Stores received message to transient (keyed by MessageSid)
 *  3. Parses command keywords (STOP, STATUS, HELP)
 *  4. Returns TwiML XML response
 *
 * IMPORTANT: The REST response must be Content-Type: application/xml
 * This is handled by adding a filter in the microplugin — see notes below.
 *
 * Replace 104 with the actual Post ID of this Microplugin.
 */
function cem_microplugin_callback_104( WP_REST_Request $request ) {
    $auth_token = CEM::option( 'cem_twilio_auth_token' );

    // ── 1. Validate Twilio signature ─────────────────────────────────────────
    if ( $auth_token ) {
        $twilio_sig = CEM::header( 'X-Twilio-Signature' );
        $url        = CEM::site_url( '/wp-json/cem/v1/webhook/twilio' );
        $post_vars  = $request->get_body_params();

        // Sort params alphabetically, concatenate key+value pairs, then HMAC-SHA1
        ksort( $post_vars );
        $data = $url;
        foreach ( $post_vars as $k => $v ) {
            $data .= $k . $v;
        }
        $expected = base64_encode( hash_hmac( 'sha1', $data, $auth_token, true ) );

        if ( ! hash_equals( $expected, (string) $twilio_sig ) ) {
            // Return forbidden TwiML — Twilio shows this to the sender
            return cem_twiml_response( '<Response><Message>Invalid request.</Message></Response>' );
        }
    }

    // ── 2. Extract message data ───────────────────────────────────────────────
    $message_sid  = sanitize_text_field( CEM::param( 'MessageSid', '' ) );
    $from         = sanitize_text_field( CEM::param( 'From', '' ) );
    $to           = sanitize_text_field( CEM::param( 'To', '' ) );
    $body         = sanitize_textarea_field( CEM::param( 'Body', '' ) );
    $num_media    = (int) CEM::param( 'NumMedia', 0 );

    if ( ! $message_sid || ! $from ) {
        return cem_twiml_response( '<Response></Response>' );
    }

    // ── 3. Store message ──────────────────────────────────────────────────────
    $msg_data = array(
        'message_sid' => $message_sid,
        'from'        => $from,
        'to'          => $to,
        'body'        => $body,
        'num_media'   => $num_media,
        'received_at' => current_time( 'mysql' ),
    );

    CEM::store( 'sms_' . $message_sid, $msg_data, 30 * DAY_IN_SECONDS );

    // Also append to sender history
    $history   = CEM::retrieve( 'sms_history_' . md5( $from ), array() );
    $history[] = $msg_data;
    $history   = array_slice( $history, -50 ); // keep last 50 messages per sender
    CEM::store( 'sms_history_' . md5( $from ), $history, 90 * DAY_IN_SECONDS );

    // ── 4. Parse command keywords ─────────────────────────────────────────────
    $command = strtoupper( trim( $body ) );
    $reply   = '';

    if ( 'STOP' === $command || 'UNSUBSCRIBE' === $command ) {
        // Twilio handles STOP automatically; log it
        $reply = 'You have been unsubscribed. Reply START to re-subscribe.';

    } elseif ( 'START' === $command || 'SUBSCRIBE' === $command ) {
        $reply = 'Welcome back! You are now subscribed.';

    } elseif ( 'STATUS' === $command ) {
        $site  = get_bloginfo( 'name' );
        $reply = "Status: {$site} is operational. " . CEM::now();

    } elseif ( 'HELP' === $command ) {
        $reply = 'Commands: STATUS (site status), STOP (unsubscribe). Reply HELP for this message.';

    } else {
        // Echo back with acknowledgement + queue async processing if needed
        $reply = 'Received: ' . Lib::truncate_text( $body, 80 );

        // Queue async job to process the inbound message
        CEM::queue( 'internal/process-inbound-sms', array(
            'message_sid' => $message_sid,
            'from'        => $from,
            'body'        => $body,
        ) );
    }

    $twiml = '<Response>';
    if ( $reply ) {
        $twiml .= '<Message>' . esc_xml( $reply ) . '</Message>';
    }
    $twiml .= '</Response>';

    return cem_twiml_response( $twiml );
}

/**
 * Return a WP_REST_Response with correct TwiML content-type.
 */
function cem_twiml_response( string $xml ): WP_REST_Response {
    $response = CEM::response( $xml );
    $response->header( 'Content-Type', 'application/xml; charset=utf-8' );
    return $response;
}

// esc_xml is WP 5.5+; polyfill for safety
if ( ! function_exists( 'esc_xml' ) ) {
    function esc_xml( $text ) {
        return htmlspecialchars( $text, ENT_XML1 | ENT_QUOTES, 'UTF-8' );
    }
}
