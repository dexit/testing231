<?php
/**
 * EXAMPLE MICROPLUGIN — copy this code into a new Microplugin post in the WP admin.
 *
 * After publishing, note the Post ID (e.g. 123). The callback function name
 * MUST be: cem_microplugin_callback_{POST_ID}
 *
 * Then go to Settings > Custom Endpoints and create an endpoint with:
 *   Slug:        hello-world
 *   Methods:     GET
 *   Capability:  read
 *   Microplugin: (select this post)
 *
 * Test: GET /wp-json/cem/v1/hello-world?name=Alice
 *
 * ─── Context-aware template tags (injected automatically) ───────────────────
 * CEM::param('key', $default) — sanitized request param
 * CEM::params()               — all request params as array
 * CEM::body()                 — decoded JSON request body (POST/PUT)
 * CEM::header('X-Key')        — request header value
 * CEM::method()               — HTTP method (GET/POST/…)
 * CEM::route()                — REST route string
 * CEM::user()                 — WP_User|null for current user
 * CEM::user_id()              — current user ID (0 = guest)
 * CEM::option($key)           — get_option() shorthand
 * CEM::now()                  — current_time('mysql')
 * CEM::site_url($path)        — site_url() shorthand
 * CEM::response($data, 200)   — WP_REST_Response factory
 * CEM::error($code, $msg, 400)— WP_Error factory
 *
 * ─── Function library shorthand ─────────────────────────────────────────────
 * Lib:: is an alias for CEM_Function_Library — e.g. Lib::extract_field(…)
 * Browse all 16 helpers: GET /wp-json/cem/v1/functions/library
 */

/**
 * Replace 123 with the actual Post ID of this Microplugin.
 *
 * @param WP_REST_Request $request
 * @return array|WP_REST_Response|WP_Error
 */
function cem_microplugin_callback_123( WP_REST_Request $request ) {
    $name = sanitize_text_field( CEM::param( 'name', '' ) );

    // Lib:: is CEM_Function_Library — dot-path extraction, validation helpers, etc.
    $tags = Lib::split_string( CEM::param( 'tags', '' ) );  // "php,rest,wp" → ['php','rest','wp']

    return CEM::response( array(
        'message'    => $name ? "Hello, {$name}!" : 'Hello, World!',
        'tags'       => $tags,
        'route'      => CEM::route(),
        'method'     => CEM::method(),
        'user_id'    => CEM::user_id(),
        'timestamp'  => CEM::now(),
        'site'       => CEM::site_url(),
    ) );
}
