<?xml version="1.0"?>
<ruleset name="Webhook Router &amp; Mapper">
    <description>WordPress Coding Standards for WRM plugin</description>

    <!-- Check these paths -->
    <file>webhook-router-mapper.php</file>
    <file>includes/</file>
    <file>admin/</file>

    <!-- Exclude generated/vendor files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <!-- WordPress-Extra is the base standard -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax [] -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Short ternary ?: is fine for null coalescing patterns -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <!-- Squiz comment formatting is overly strict for a WP plugin -->
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.WrongStyle"/>
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingReturn"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <!-- Allow longer lines for SQL/JSON chains -->
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <!--
            Table-name interpolation in $wpdb->prepare() is safe because table names
            come from internal WRM_Installer constants ($wpdb->prefix . CONSTANT), never
            from user input. Excluding this sniff avoids hundreds of false-positive comments
            while still catching any real SQL injection via user-supplied values.
        -->
        <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
    </rule>

    <!-- Target PHP 8.1+ -->
    <config name="testVersion" value="8.1-"/>

    <!-- Text domain for i18n checks -->
    <config name="text_domain" value="wrm"/>

    <!-- Minimum WP version for deprecated function checks -->
    <config name="minimum_supported_wp_version" value="6.4"/>

    <!-- Allow PSR-4-style namespaced class file names -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>

    <!-- Allow longer lines in complex SQL/JSON chains -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
</ruleset>
