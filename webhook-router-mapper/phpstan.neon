includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - webhook-router-mapper.php
        - includes/
        - admin/
    excludePaths:
        - vendor/
        - node_modules/
        - build/
        # Elementor integration — requires Elementor stubs not available in CI
        - includes/class-wrm-elementor.php
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - phpstan-bootstrap.php
    dynamicConstantNames:
        - WP_DEBUG
        - ABSPATH
        - WPINC
